{
  "name": "rimsage",
  "version": "1.0.2",
  "description": "An MCP server that enables searching and browsing of RimWorld source code.",
  "main": "src/stdio.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realloon/RimSage.git"
  },
  "homepage": "https://rimsage.com",
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun src/stdio.ts",
    "start:http": "bun src/http.ts",
    "clean": "bun src/scripts/clean-db.ts",
    "index:defs": "bun src/scripts/index-defs.ts",
    "index:csharp": "bun src/scripts/index-csharp.ts",
    "build": "bun run clean && bun run index:defs && bun run index:csharp",
    "type-check": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "fast-xml-builder": "^1.3.1",
    "fast-xml-parser": "^5.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
